{
  "name": "ubiq-chatbot-front-end",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:wbe": "vite --mode development.wbe",
    "build": "tsc && npm run build:production && npm run build:staging",
    "build:production": "vite build --mode production.wbe",
    "build:staging": "vite build --mode staging.wbe",
    "build:landing": "tsc && vite build --config vite.landing.config.ts --mode production.wbe",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@assistant-ui/react-markdown": "^0.14.17",
    "@okikio/sharedworker": "^1.0.7",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsrsasign": "^11.1.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.49.0",
    "navigator.locks": "^0.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^3.7.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsrsasign": "^10.5.13",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.28",
    "socket.io": "^4.8.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
